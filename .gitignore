# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# Operating system & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Antigravity / Agent workspace caches
.gemini/
*.log

# Runtime user feedback logs
data/user_feedback_reports.jsonl

# Explicitly ensure model weights and datasets are tracked
!data/*.json
!data/*.csv
!data/*.npz
!.streamlit/config.toml
